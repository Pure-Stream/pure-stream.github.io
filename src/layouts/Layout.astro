---
import Navigation from '../components/Navigation.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'guide' | 'about' | 'feedback' | 'privacy' | 'delete-account';
}

const {
  title,
  description = 'StudyBible is a focused, offline Bible reading and study app from PureStream.',
  active,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch {}
    </script>
  </head>
  <body>
    <Navigation currentPage={active} />
    <slot />
    <SiteFooter />
  </body>
</html>
