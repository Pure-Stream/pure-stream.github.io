---
import Layout from '../layouts/Layout.astro';
import { API_ROUTES, ROUTES } from '../config/constants';

export const prerender = false; // This page needs to be server-rendered for auth
---

<Layout title="Login - StudyBible" description="Sign in to your StudyBible account">
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="max-w-md w-full">
      <!-- Back to Home -->
      <div class="text-center mb-8">
        <a href={ROUTES.HOME} class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Home
        </a>
      </div>

      <!-- Login Card -->
      <div class="bg-white/60 backdrop-blur-sm rounded-2xl shadow-xl p-8 border border-white/20">
        <div class="text-center mb-8">
          <h1 class="text-3xl font-display font-bold bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent mb-2">
            Welcome Back
          </h1>
          <p class="text-gray-600">Sign in to your account to continue</p>
        </div>

        <!-- OAuth Providers -->
        <div class="space-y-3 mb-6">
          <form method="post" action={API_ROUTES.GOOGLE_SIGNIN}>
            <button
              type="submit"
              class="w-full flex items-center justify-center gap-3 px-6 py-3 bg-white border-2 border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-md transition-all group"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
              <span class="font-medium text-gray-700 group-hover:text-gray-900">Continue with Google</span>
            </button>
          </form>

          <!-- Add GitHub OAuth option -->
          <form method="post" action={API_ROUTES.GITHUB_SIGNIN}>
            <button
              type="submit"
              class="w-full flex items-center justify-center gap-3 px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-all"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span class="font-medium">Continue with GitHub</span>
            </button>
          </form>
        </div>

        <!-- Divider -->
        <div class="relative my-6">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-300"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-4 bg-white text-gray-500">Or continue with email</span>
          </div>
        </div>

        <!-- Email/Password Form -->
        <form id="credentials-form" class="space-y-4">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Email Address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
              Password
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition"
              placeholder="••••••••"
            />
          </div>

          <div id="error-message" class="hidden text-red-600 text-sm"></div>

          <div class="flex items-center justify-between text-sm">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
              <span class="text-gray-600">Remember me</span>
            </label>
            <a href={ROUTES.FORGOT_PASSWORD} class="text-blue-600 hover:text-blue-700">
              Forgot password?
            </a>
          </div>

          <button
            type="submit"
            id="signin-button"
            class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold py-3 rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all shadow-md hover:shadow-lg"
          >
            Sign In
          </button>
        </form>

        <!-- Sign Up Link -->
        <p class="text-center text-sm text-gray-600 mt-6">
          Don't have an account?
          <a href={ROUTES.SIGNUP} class="text-blue-600 hover:text-blue-700 font-semibold">
            Sign up for free
          </a>
        </p>
      </div>

      <!-- Terms -->
      <p class="text-center text-xs text-gray-500 mt-6">
        By signing in, you agree to our
        <a href={ROUTES.TERMS} class="text-blue-600 hover:underline">Terms of Service</a>
        and
        <a href={ROUTES.PRIVACY} class="text-blue-600 hover:underline">Privacy Policy</a>
      </p>
    </div>
  </div>
</Layout>

<script>
  document.getElementById('credentials-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const form = e.target as HTMLFormElement;
    const email = (form.querySelector('#email') as HTMLInputElement).value;
    const password = (form.querySelector('#password') as HTMLInputElement).value;
    const button = document.getElementById('signin-button') as HTMLButtonElement;
    const errorDiv = document.getElementById('error-message') as HTMLDivElement;

    // Disable button and show loading state
    button.disabled = true;
    button.textContent = 'Signing in...';
    errorDiv.classList.add('hidden');

    try {
      // Use custom signin endpoint
      console.log('Attempting sign in with custom endpoint...');

      const response = await fetch('/api/auth/signin-custom', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          email,
          password
        })
      });

      const data = await response.json();
      console.log('Response:', data);

      if (response.ok && data.success) {
        console.log('✅ Login successful!');
        // Redirect to dashboard
        window.location.href = '/dashboard';
      } else {
        // Show error message
        errorDiv.textContent = data.error || 'Invalid email or password';
        errorDiv.classList.remove('hidden');
        button.disabled = false;
        button.textContent = 'Sign In';
      }
    } catch (error) {
      console.error('Login error:', error);
      errorDiv.textContent = 'An error occurred. Please try again.';
      errorDiv.classList.remove('hidden');
      button.disabled = false;
      button.textContent = 'Sign In';
    }
  });
</script>

<style>
  /* Add subtle animation to the card */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  div > div {
    animation: fadeInUp 0.5s ease-out;
  }
</style>
