---
import ButtonLink from '../components/ButtonLink.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PlatformList from '../components/PlatformList.astro';
import ReaderPreview from '../components/ReaderPreview.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { APP_CONFIG, FEATURES } from '../config/constants';
import Layout from '../layouts/Layout.astro';
---

<Layout title="StudyBible — a quieter place to study" active="home">
  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">A reading space by PureStream</p>
          <h1 class="display">Make room<br />for the text.</h1>
          <p class="lead">StudyBible brings scripture, notes, and the tools you use most into one focused place. Read offline. Pick up where you left off.</p>
          <div class="button-row">
            <ButtonLink href={APP_CONFIG.RELEASES_URL} variant="primary" external>Get the latest build <span aria-hidden="true">↗</span></ButtonLink>
            <ButtonLink href="/guide/">Explore features <span aria-hidden="true">→</span></ButtonLink>
          </div>
          <p class="hero-note">Evaluation builds for Windows, Linux, and Android.</p>
        </div>
        <ReaderPreview />
      </div>
    </section>

    <section class="section section-soft" id="features">
      <div class="container">
        <SectionHeading eyebrow="The essentials" title="Tools that serve the reading" description="A practical study space for looking closer, saving context, and returning to a passage later." />
        <div class="feature-grid">
          {FEATURES.map(feature => <FeatureCard {...feature} />)}
        </div>
        <p class="small body-muted" style="margin:22px 0 0">Learn more about the <a class="text-link" href="/guide/">features and supported platforms</a>.</p>
      </div>
    </section>

    <section class="section">
      <div class="container grid-two split-centered">
        <div>
          <p class="eyebrow">Local first</p>
          <h2 class="section-title">A place for personal study.</h2>
          <p class="lead">Your bookmarks, highlights, and notes live on your device. An account is optional; sign in when you want to sync them across devices.</p>
          <a class="text-link" href="/privacy/">How StudyBible handles data →</a>
        </div>
        <div class="panel">
          <p class="eyebrow">Made for the way you read</p>
          <ul class="list-clean">
            <li><strong>Start anywhere.</strong><br /><span class="body-muted small">Browse translations and download what you need.</span></li>
            <li><strong>Stay with the passage.</strong><br /><span class="body-muted small">Read in a clear layout, with comparison close by.</span></li>
            <li><strong>Keep the context.</strong><br /><span class="body-muted small">Mark a verse, add a note, and return later.</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section section-soft" id="download">
      <div class="container grid-two split-spacious">
        <div>
          <p class="eyebrow">Get StudyBible</p>
          <h2 class="section-title">Find your platform.</h2>
          <p class="lead">StudyBible is in active development. The current builds are available for evaluation on Windows, Linux, and Android.</p>
          <div class="button-row" style="margin-top:28px">
            <ButtonLink href={APP_CONFIG.RELEASES_URL} variant="primary" external>View latest release <span aria-hidden="true">↗</span></ButtonLink>
          </div>
        </div>
        <PlatformList />
      </div>
      <div class="container" style="margin-top:52px">
        <div class="notice"><strong>Development status</strong><p>These builds are for evaluation while the app is being developed. Features and platform support may change between releases.</p></div>
      </div>
    </section>
  </main>
</Layout>
