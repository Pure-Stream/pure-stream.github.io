---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import { getSession } from 'auth-astro/server';

export const prerender = false; // Need server-side rendering for session

const session = await getSession(Astro.request);
---

<Layout title="StudyBible - Native Bible Study Application">
  <Navigation currentPage="home" />

  <main>
    <!-- Compact Hero Section -->
    <section class="relative overflow-hidden py-12 px-6">
      <div class="max-w-6xl mx-auto text-center">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl shadow-xl mb-6">
          <span class="text-4xl">📖</span>
        </div>

        <h1 class="font-display text-5xl md:text-6xl font-bold bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent mb-3">
          StudyBible
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-300 mb-2 max-w-2xl mx-auto">
          Native Bible study application built with Rust
        </p>
        <p class="text-slate-500 dark:text-slate-400 mb-6 max-w-xl mx-auto">
          1000+ translations · Parallel view · Fast & offline
        </p>

        <div class="flex flex-wrap gap-3 justify-center mb-8">
          <a href="#download" class="px-6 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all">
            Download Now →
          </a>
          <a href="/feedback" class="px-6 py-2.5 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold rounded-lg shadow-md hover:shadow-lg transition-all border border-slate-200 dark:border-slate-700">
            Give Feedback
          </a>
        </div>

        <!-- Compact Stats -->
        <div class="flex flex-wrap gap-4 justify-center text-sm">
          <div class="px-4 py-2 bg-white/60 backdrop-blur-sm rounded-lg border border-white">
            <span class="font-bold text-blue-600">1000+</span> Translations
          </div>
          <div class="px-4 py-2 bg-white/60 backdrop-blur-sm rounded-lg border border-white">
            <span class="font-bold text-indigo-600">66</span> Books
          </div>
          <div class="px-4 py-2 bg-white/60 backdrop-blur-sm rounded-lg border border-white">
            <span class="font-bold text-purple-600">4</span> Platforms
          </div>
          <div class="px-4 py-2 bg-white/60 backdrop-blur-sm rounded-lg border border-white">
            <span class="font-bold text-pink-600">100%</span> Free
          </div>
        </div>
      </div>

      <!-- Decorative blobs -->
      <div class="absolute top-10 left-10 w-64 h-64 bg-blue-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob"></div>
      <div class="absolute top-20 right-10 w-64 h-64 bg-purple-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000"></div>
    </section>

    <!-- Compact Features Section -->
    <section id="features" class="py-12 px-6 bg-white/40 dark:bg-slate-800/40 backdrop-blur-sm">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="font-display text-3xl font-bold text-slate-800 dark:text-slate-100 mb-2">Key Features</h2>
          <p class="text-slate-600 dark:text-slate-300">Everything you need for Bible study</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="p-5 bg-white dark:bg-slate-900 rounded-xl shadow-md border border-slate-100 dark:border-slate-700 hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🌍</span>
              <div>
                <h3 class="font-bold text-slate-800 dark:text-slate-100 mb-1">1000+ Translations</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">100+ languages with offline support</p>
              </div>
            </div>
          </div>

          <div class="p-5 bg-white dark:bg-slate-900 rounded-xl shadow-md border border-slate-100 dark:border-slate-700 hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-3">
              <span class="text-2xl">↔️</span>
              <div>
                <h3 class="font-bold text-slate-800 dark:text-slate-100 mb-1">Parallel View</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">Compare translations side-by-side</p>
              </div>
            </div>
          </div>

          <div class="p-5 bg-white dark:bg-slate-900 rounded-xl shadow-md border border-slate-100 dark:border-slate-700 hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🔍</span>
              <div>
                <h3 class="font-bold text-slate-800 dark:text-slate-100 mb-1">Smart Search</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">Find verses instantly across translations</p>
              </div>
            </div>
          </div>

          <div class="p-5 bg-white dark:bg-slate-900 rounded-xl shadow-md border border-slate-100 dark:border-slate-700 hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🔖</span>
              <div>
                <h3 class="font-bold text-slate-800 dark:text-slate-100 mb-1">Bookmarks & Notes</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">Save verses with personal annotations</p>
              </div>
            </div>
          </div>

          <div class="p-5 bg-white dark:bg-slate-900 rounded-xl shadow-md border border-slate-100 dark:border-slate-700 hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🎨</span>
              <div>
                <h3 class="font-bold text-slate-800 dark:text-slate-100 mb-1">Dark Mode</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">Beautiful themes for any lighting</p>
              </div>
            </div>
          </div>

          <div class="p-5 bg-white dark:bg-slate-900 rounded-xl shadow-md border border-slate-100 dark:border-slate-700 hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-3">
              <span class="text-2xl">⚡</span>
              <div>
                <h3 class="font-bold text-slate-800 dark:text-slate-100 mb-1">Native Performance</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">Built with Rust for blazing speed</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Download Section -->
    <section id="download" class="py-12 px-6 bg-gradient-to-br from-blue-600 via-indigo-600 to-purple-600">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="font-display text-3xl font-bold text-white mb-2">Download StudyBible</h2>
        <p class="text-blue-100 mb-8">Available for all major platforms</p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
          <div class="p-6 bg-white/10 backdrop-blur-md rounded-xl border border-white/20 hover:bg-white/20 transition-all text-center group cursor-pointer">
            <div class="text-4xl mb-2">🪟</div>
            <h3 class="text-lg font-bold text-white mb-1">Windows</h3>
            <p class="text-blue-100 text-sm">Windows 10+</p>
          </div>

          <div class="p-6 bg-white/10 backdrop-blur-md rounded-xl border border-white/20 hover:bg-white/20 transition-all text-center group cursor-pointer">
            <div class="text-4xl mb-2">🍎</div>
            <h3 class="text-lg font-bold text-white mb-1">macOS</h3>
            <p class="text-blue-100 text-sm">macOS 10.15+</p>
          </div>

          <div class="p-6 bg-white/10 backdrop-blur-md rounded-xl border border-white/20 hover:bg-white/20 transition-all text-center group cursor-pointer">
            <div class="text-4xl mb-2">🐧</div>
            <h3 class="text-lg font-bold text-white mb-1">Linux</h3>
            <p class="text-blue-100 text-sm">All distributions</p>
          </div>

          <div class="p-6 bg-white/10 backdrop-blur-md rounded-xl border border-white/20 hover:bg-white/20 transition-all text-center group cursor-pointer">
            <div class="text-4xl mb-2">🤖</div>
            <h3 class="text-lg font-bold text-white mb-1">Android</h3>
            <p class="text-blue-100 text-sm">Coming Soon</p>
          </div>
        </div>

        <p class="text-blue-100 mt-6 text-sm">
          Completely free to download and use
        </p>
      </div>
    </section>

    <!-- Tech Stack - Compact -->
    <section class="py-12 px-6 bg-slate-50 dark:bg-slate-900">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="font-display text-3xl font-bold text-slate-800 dark:text-slate-100 mb-2">Built with Modern Tech</h2>
          <p class="text-slate-600 dark:text-slate-300">Powered by cutting-edge frameworks</p>
        </div>

        <div class="flex flex-wrap gap-4 justify-center items-center">
          <div class="flex items-center gap-3 px-6 py-4 bg-white dark:bg-slate-800 rounded-xl shadow-md">
            <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900/30 rounded-lg flex items-center justify-center">
              <span class="text-2xl">🦀</span>
            </div>
            <div class="text-left">
              <div class="font-bold text-slate-800 dark:text-slate-100">Rust</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">Performance & Safety</div>
            </div>
          </div>

          <div class="flex items-center gap-3 px-6 py-4 bg-white dark:bg-slate-800 rounded-xl shadow-md">
            <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center">
              <span class="text-lg font-bold text-purple-600 dark:text-purple-400">Dx</span>
            </div>
            <div class="text-left">
              <div class="font-bold text-slate-800 dark:text-slate-100">Dioxus</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">Reactive UI</div>
            </div>
          </div>

          <div class="flex items-center gap-3 px-6 py-4 bg-white dark:bg-slate-800 rounded-xl shadow-md">
            <div class="w-12 h-12 bg-sky-100 dark:bg-sky-900/30 rounded-lg flex items-center justify-center">
              <span class="text-2xl text-sky-500 dark:text-sky-400">🎨</span>
            </div>
            <div class="text-left">
              <div class="font-bold text-slate-800 dark:text-slate-100">Tailwind</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">Modern Styling</div>
            </div>
          </div>

          <div class="flex items-center gap-3 px-6 py-4 bg-white dark:bg-slate-800 rounded-xl shadow-md">
            <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center">
              <span class="text-2xl">⚡</span>
            </div>
            <div class="text-left">
              <div class="font-bold text-slate-800 dark:text-slate-100">Tokio</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">Async Runtime</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-8 px-6 bg-slate-900 dark:bg-black">
      <div class="max-w-6xl mx-auto text-center">
        <div class="text-3xl mb-3">📖</div>
        <h3 class="text-xl font-bold text-white mb-2">StudyBible</h3>
        <div class="flex gap-6 justify-center mb-4 text-sm">
          <a href="/feedback" class="text-slate-400 dark:text-slate-500 hover:text-white transition-colors">Feedback</a>
          <a href="#features" class="text-slate-400 dark:text-slate-500 hover:text-white transition-colors">Features</a>
          <a href="#download" class="text-slate-400 dark:text-slate-500 hover:text-white transition-colors">Download</a>
        </div>
        <p class="text-slate-500 dark:text-slate-600 text-sm">Built with ❤️ using Rust and Dioxus</p>
      </div>
    </footer>
  </main>
</Layout>

<script>
  import { initTheme, setupThemeToggle } from '../scripts/theme';

  // Initialize theme immediately to prevent flash
  initTheme();

  // Setup theme toggle when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    setupThemeToggle();
  });
</script>

<style>
  @keyframes blob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
  }
  .animate-blob { animation: blob 7s infinite; }
  .animation-delay-2000 { animation-delay: 2s; }
</style>
