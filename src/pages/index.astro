---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import { APP_CONFIG, FEATURES, PLATFORMS, TECH_STACK, APP_STATS } from '../config/constants';

export const prerender = false;

const session = Astro.locals.session;
---

<Layout title={`${APP_CONFIG.NAME} - ${APP_CONFIG.TAGLINE}`}>
  <Navigation currentPage="home" />

  <main class="relative">
    <!-- Hero Section -->
    <section class="relative pt-20 pb-32 px-6 overflow-hidden">
      <div class="max-w-7xl mx-auto text-center relative z-10">
        <!-- Coming Soon Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/30 border border-blue-100 dark:border-blue-800 text-blue-600 dark:text-blue-400 text-xs font-bold tracking-wider uppercase mb-8 animate-fade-in">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
          </span>
          {APP_CONFIG.STATUS} • {APP_CONFIG.VERSION}
        </div>

        <div class="flex justify-center mb-8">
          <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-3xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
            <div class="relative flex items-center justify-center w-24 h-24 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl ring-1 ring-slate-200 dark:ring-slate-800 transition-transform hover:scale-105 duration-300">
              <span class="text-5xl">{APP_CONFIG.ICON}</span>
            </div>
          </div>
        </div>

        <h1 class="font-display text-6xl md:text-7xl lg:text-8xl font-extrabold tracking-tight mb-6">
          <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">
            {APP_CONFIG.NAME}
          </span>
        </h1>
        
        <p class="text-xl md:text-2xl text-slate-600 dark:text-slate-300 mb-4 max-w-3xl mx-auto leading-relaxed font-medium">
          {APP_CONFIG.DESCRIPTION}
        </p>
        <p class="text-lg text-slate-500 dark:text-slate-400 mb-10 max-w-2xl mx-auto">
          {APP_CONFIG.TAGLINE}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
          <a href="#download" class="w-full sm:w-auto px-8 py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold rounded-xl shadow-xl hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">
            Get Notified
          </a>
          <a href="/feedback" class="w-full sm:w-auto px-8 py-4 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold rounded-xl shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 border border-slate-200 dark:border-slate-700">
            View Project Status
          </a>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8 max-w-4xl mx-auto">
          {Object.entries(APP_STATS).map(([key, value]) => (
            <div class="p-6 bg-white/40 dark:bg-slate-800/40 backdrop-blur-md rounded-2xl border border-white/20 dark:border-slate-700/30">
              <div class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white mb-1">{value}</div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">{key}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Decorative Background Elements -->
      <div class="absolute top-1/4 -left-20 w-96 h-96 bg-blue-400/20 rounded-full mix-blend-multiply filter blur-[100px] animate-blob"></div>
      <div class="absolute top-1/3 -right-20 w-96 h-96 bg-purple-400/20 rounded-full mix-blend-multiply filter blur-[100px] animate-blob animation-delay-2000"></div>
      <div class="absolute -bottom-20 left-1/2 -translate-x-1/2 w-[800px] h-96 bg-indigo-500/10 rounded-full mix-blend-multiply filter blur-[100px] animate-blob animation-delay-4000"></div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-24 px-6 relative">
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="text-center mb-20">
          <h2 class="font-display text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4 tracking-tight">
            Designed for the <span class="text-blue-600 italic">Serious Student</span>
          </h2>
          <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
            Everything you need for a deep, focused Bible study experience, all in one fast, native application.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {FEATURES.map(feature => (
            <div class="group p-8 bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-800 hover:shadow-2xl hover:border-blue-100 dark:hover:border-blue-900/30 transition-all duration-500 hover:-translate-y-2">
              <div class="w-14 h-14 bg-slate-50 dark:bg-slate-800 rounded-2xl flex items-center justify-center text-3xl mb-6 group-hover:scale-110 group-hover:bg-blue-50 dark:group-hover:bg-blue-900/20 transition-all duration-500">
                {feature.icon}
              </div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{feature.title}</h3>
              <p class="text-slate-600 dark:text-slate-400 leading-relaxed">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Tech Stack Section -->
    <section class="py-24 px-6 bg-slate-900 overflow-hidden relative">
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#3b82f6_1px,transparent_1px)] [background-size:40px_40px]"></div>
      
      <div class="max-w-7xl mx-auto relative z-10 text-center">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-16">Engineered for Performance</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {TECH_STACK.map(tech => (
            <div class="flex items-center gap-4 p-6 bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 hover:bg-white/10 transition-all duration-300">
              <div class={`w-14 h-14 ${tech.bgColor} rounded-xl flex items-center justify-center`}>
                <span class="text-3xl">{tech.icon === 'Dx' ? <span class="text-lg font-black font-display text-purple-600 dark:text-purple-400">Dx</span> : tech.icon}</span>
              </div>
              <div class="text-left">
                <div class="font-bold text-white text-lg">{tech.name}</div>
                <div class="text-sm text-slate-400">{tech.description}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Download/Coming Soon Section -->
    <section id="download" class="py-24 px-6 relative overflow-hidden bg-slate-50 dark:bg-slate-950">
      <div class="max-w-7xl mx-auto relative z-10 text-center">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-6">Coming to Every Screen</h2>
        <p class="text-lg text-slate-600 dark:text-slate-400 mb-16 max-w-2xl mx-auto">
          We're hard at work bringing StudyBible to your favorite platform. 
          Sign up to be the first to know when we launch.
        </p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto mb-16">
          {PLATFORMS.map(platform => (
            <div class="relative group p-8 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 hover:shadow-xl transition-all duration-500">
              <div class="absolute top-4 right-4 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-tighter bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800 opacity-0 group-hover:opacity-100 transition-opacity">
                {platform.status}
              </div>
              <div class="text-5xl mb-6 group-hover:scale-110 transition-transform duration-500">{platform.icon}</div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-1">{platform.name}</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">{platform.requirement}</p>
            </div>
          ))}
        </div>

        <!-- Notify Form Placeholder -->
        <div class="max-w-md mx-auto">
          <form class="flex flex-col sm:flex-row gap-3">
            <input 
              type="email" 
              placeholder="Enter your email" 
              class="flex-1 px-5 py-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:ring-2 focus:ring-blue-500 outline-none transition-all dark:text-white"
            />
            <button class="px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg transition-all">
              Notify Me
            </button>
          </form>
          <p class="mt-4 text-xs text-slate-500 dark:text-slate-500">
            No spam, just a single email when we launch.
          </p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-16 px-6 border-t border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-950">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-center gap-10">
          <div class="flex items-center gap-3">
            <span class="text-3xl">{APP_CONFIG.ICON}</span>
            <span class="font-display text-2xl font-black bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
              {APP_CONFIG.NAME}
            </span>
          </div>

          <div class="flex flex-wrap gap-x-10 gap-y-4 justify-center text-sm font-semibold text-slate-500 dark:text-slate-400">
            <a href="#features" class="hover:text-blue-600 transition-colors">Features</a>
            <a href="#download" class="hover:text-blue-600 transition-colors">Platforms</a>
            <a href="/feedback" class="hover:text-blue-600 transition-colors">Feedback</a>
            <a href={APP_CONFIG.GITHUB_URL} target="_blank" class="hover:text-blue-600 transition-colors">GitHub</a>
          </div>

          <div class="text-slate-400 dark:text-slate-600 text-sm">
            &copy; {new Date().getFullYear()} {APP_CONFIG.NAME}. Built with Rust.
          </div>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<script>

  import { initTheme, setupThemeToggle } from '../scripts/theme';



  // Initialize theme immediately to prevent flash

  initTheme();



  // Setup theme toggle when DOM is ready

  document.addEventListener('DOMContentLoaded', () => {

    setupThemeToggle();

  });

</script>
