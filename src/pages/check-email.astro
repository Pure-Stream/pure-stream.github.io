---
import Layout from '../layouts/Layout.astro';
import { ROUTES } from '../config/constants';

export const prerender = false;

const email = Astro.url.searchParams.get('email') || 'your email';
---

<Layout title="Check Your Email - PureStream's StudyBible" description="Check your email to verify your account">
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="max-w-md w-full">
      <div class="bg-white/60 backdrop-blur-sm rounded-2xl shadow-xl p-8 border border-white/20 text-center">
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-4">
            <svg
              class="w-8 h-8 text-blue-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              />
            </svg>
          </div>
        </div>

        <h1 class="text-3xl font-display font-bold bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent mb-2">
          Check Your Email
        </h1>

        <p class="text-gray-600 mb-2">
          We've sent a verification link to:
        </p>
        <p class="text-lg font-semibold text-gray-800 mb-6">
          {email}
        </p>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
          <p class="text-sm text-blue-900">
            <span class="font-semibold">📧 Next steps:</span>
            <br />
            <br />
            1. Check your email (including spam folder)
            <br />
            2. Click the verification link
            <br />
            3. Return here to sign in
            <br />
            <br />
            <span class="text-blue-700">
              ⏱️ The link expires in 24 hours
            </span>
          </p>
        </div>

        <a
          href={ROUTES.LOGIN}
          class="inline-block w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold py-3 rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all shadow-md hover:shadow-lg mb-4"
        >
          Go to Sign In
        </a>

        <p class="text-sm text-gray-600 mb-6">
          Didn't receive the email?
          <a
            href={ROUTES.SIGNUP}
            class="text-blue-600 hover:text-blue-700 font-semibold"
          >
            Try signing up again
          </a>
        </p>

        <a
          href={ROUTES.HOME}
          class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            />
          </svg>
          Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  div > div {
    animation: fadeInUp 0.5s ease-out;
  }
</style>
