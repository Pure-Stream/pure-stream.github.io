---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import { APP_CONFIG, TECH_STACK } from '../config/constants';
---

<Layout title="About - PureStream's StudyBible">
  <Navigation currentPage="about" />

  <main class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-900 py-16 px-6 relative overflow-hidden">
    <div class="absolute top-0 left-0 w-96 h-96 bg-blue-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob dark:opacity-10"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-purple-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000 dark:opacity-10"></div>
    <div class="absolute -bottom-8 left-20 w-96 h-96 bg-pink-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000 dark:opacity-10"></div>

    <div class="max-w-4xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <div class="mb-6 text-7xl">📖</div>
        <h1 class="text-5xl md:text-6xl font-bold bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent mb-4">
          About {APP_CONFIG.NAME}
        </h1>
        <p class="text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
          {APP_CONFIG.DESCRIPTION}
        </p>
      </div>

      <div class="bg-white/60 dark:bg-slate-800/60 backdrop-blur-md border border-white/20 dark:border-slate-700/20 rounded-3xl p-8 md:p-12 mb-12">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6">Our Mission</h2>
        <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          We believe that Bible study should be accessible to everyone, everywhere. Our mission is to create a modern, fast, and intuitive Bible study application that helps readers deepen their understanding of scripture without distractions.
        </p>
        <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Built with cutting-edge technology, {APP_CONFIG.NAME} combines the performance and safety of Rust with the reactive power of Dioxus to deliver a native experience across all your devices.
        </p>
      </div>

      <div class="bg-white/60 dark:bg-slate-800/60 backdrop-blur-md border border-white/20 dark:border-slate-700/20 rounded-3xl p-8 md:p-12 mb-12">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8 text-center">Built With Modern Technology</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {TECH_STACK.map(tech => (
            <div class="bg-white/60 dark:bg-slate-900/60 backdrop-blur-sm rounded-xl p-6 text-center border border-white/20 dark:border-slate-700/30">
              <div class="text-2xl mb-3">{tech.icon}</div>
              <h3 class="font-semibold text-slate-900 dark:text-white">{tech.name}</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400">{tech.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6">Open Source</h2>
        <p class="text-lg text-slate-600 dark:text-slate-300 mb-8 max-w-2xl mx-auto">
          {APP_CONFIG.NAME} is developed openly on GitHub. We welcome contributions, feedback, and ideas from the community to make this the best Bible study tool available.
        </p>
        <a
          href={APP_CONFIG.GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg hover:shadow-2xl hover:scale-105 transition-all duration-200"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.137 18.163 20 14.418 20 10c0-5.523-4.477-10-10-10z" clip-rule="evenodd"></path>
          </svg>
          View on GitHub
        </a>
      </div>
    </div>
  </main>
</Layout>
