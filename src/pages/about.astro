---
import ButtonLink from '../components/ButtonLink.astro';
import InfoCard from '../components/InfoCard.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { APP_CONFIG } from '../config/constants';
import Layout from '../layouts/Layout.astro';
---

<Layout title="About StudyBible — PureStream" active="about">
  <main>
    <PageIntro eyebrow="About the project" title="Built for the work of reading." intro="StudyBible is a native Bible study app made by PureStream. Its design begins with a simple idea: keep the passage at the center." />

    <section class="section">
      <div class="container grid-two split-spacious">
        <div>
          <p class="eyebrow">Why we make it</p>
          <h2 class="section-title">Less interface.<br />More attention.</h2>
        </div>
        <div class="prose">
          <p>Good study takes time. It often means comparing a passage, following a reference, marking a thought, and returning to it later. StudyBible puts those familiar tasks in one reading space.</p>
          <p>The app supports offline reading and keeps personal study data on your device. If you want it on more than one device, you can sign in and use online sync.</p>
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container">
        <SectionHeading eyebrow="How it is built" title="Practical choices, careful progress" description="StudyBible uses Rust and Dioxus. The app is evolving, and feedback helps shape what comes next." />
        <div class="grid-three">
          <InfoCard eyebrow="01 / Offline" title="Reading without a connection" description="Keep downloaded resources on your device and study when the network is unavailable." />
          <InfoCard eyebrow="02 / Personal" title="Your own working notes" description="Bookmarks, highlights, and notes help you keep the thread of a passage." />
          <InfoCard eyebrow="03 / Evolving" title="Room to improve" description="Follow releases, report an issue, or suggest a change on GitHub." />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container grid-two split-centered">
        <div><p class="eyebrow">Join the conversation</p><h2 class="section-title">Help shape the next version.</h2></div>
        <div><p class="lead" style="margin-top:0">StudyBible is still under active development. You can follow releases, see open issues, and share useful feedback.</p><ButtonLink href={APP_CONFIG.GITHUB_URL} variant="primary" external>View releases and issues <span aria-hidden="true">↗</span></ButtonLink></div>
      </div>
    </section>
  </main>
</Layout>
