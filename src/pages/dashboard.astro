---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import { ROUTES } from '../config/constants';

export const prerender = false;

// Get session from middleware (supports both auth-astro and custom JWT)
const session = Astro.locals.session;

// This should be protected by middleware, but double-check
if (!session) {
  return Astro.redirect(ROUTES.LOGIN);
}

const user = session.user;
---

<Layout title="Dashboard - PureStream's StudyBible" description="Your PureStream's StudyBible dashboard">
  <div class="min-h-screen">
    <Navigation currentPage="dashboard" showThemeToggle={false} />

    <!-- Dashboard Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Welcome Section -->
      <div class="bg-white/60 backdrop-blur-sm rounded-2xl shadow-xl p-8 mb-8 border border-white/20">
        <h1 class="text-4xl font-display font-bold bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent mb-4">
          Welcome Back, {user?.name || 'User'}!
        </h1>
        <p class="text-gray-600 text-lg">
          Your journey with PureStream's StudyBible continues. Explore your stats and manage your account.
        </p>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white/60 backdrop-blur-sm rounded-xl shadow-lg p-6 border border-white/20">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Total Study Time</p>
              <p class="text-3xl font-bold text-blue-600 mt-2">0 hrs</p>
            </div>
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
          </div>
        </div>

        <div class="bg-white/60 backdrop-blur-sm rounded-xl shadow-lg p-6 border border-white/20">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Bookmarks</p>
              <p class="text-3xl font-bold text-indigo-600 mt-2">0</p>
            </div>
            <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
              </svg>
            </div>
          </div>
        </div>

        <div class="bg-white/60 backdrop-blur-sm rounded-xl shadow-lg p-6 border border-white/20">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Notes</p>
              <p class="text-3xl font-bold text-purple-600 mt-2">0</p>
            </div>
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Account Settings -->
      <div class="bg-white/60 backdrop-blur-sm rounded-2xl shadow-xl p-8 border border-white/20">
        <h2 class="text-2xl font-display font-bold text-gray-900 mb-6">Account Settings</h2>

        <div class="space-y-6">
          <!-- Profile Info -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Profile Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Name</label>
                <input
                  type="text"
                  value={user?.name || ''}
                  disabled
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                <input
                  type="email"
                  value={user?.email || ''}
                  disabled
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50"
                />
              </div>
            </div>
          </div>

          <!-- Account Actions -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Account Actions</h3>
            <div class="flex gap-4">
              <a
                href="/profile/edit"
                class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
              >
                Edit Profile
              </a>
              <a
                href="/profile/change-password"
                class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors"
              >
                Change Password
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Download App CTA -->
      <div class="mt-8 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 rounded-2xl shadow-xl p-8 text-white">
        <!-- Evaluation Notice -->
        <div class="mb-6 p-4 bg-amber-50/95 dark:bg-amber-900/50 border-2 border-amber-400 dark:border-amber-600 rounded-xl">
          <div class="flex items-start gap-3">
            <span class="text-2xl">⚠️</span>
            <div class="flex-1">
              <h4 class="text-lg font-black text-amber-900 dark:text-amber-200 mb-2">EVALUATION BUILD ONLY</h4>
              <p class="text-sm font-bold text-amber-800 dark:text-amber-300">
                {APP_CONFIG.EVALUATION_NOTICE}
              </p>
            </div>
          </div>
        </div>
        
        <div class="flex flex-col md:flex-row items-center justify-between">
          <div class="mb-6 md:mb-0">
            <h2 class="text-2xl font-display font-bold mb-2">Download PureStream's StudyBible</h2>
            <p class="text-blue-100">Access your study materials offline with our desktop and mobile apps.</p>
          </div>
          <a
            href="/#download"
            class="px-8 py-3 bg-white text-blue-600 font-semibold rounded-lg hover:bg-gray-100 transition-all shadow-lg"
          >
            Download Now
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  div > div {
    animation: fadeIn 0.5s ease-out;
  }
</style>
