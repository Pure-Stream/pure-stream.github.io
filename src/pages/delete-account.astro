---
import PageIntro from '../components/PageIntro.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Delete your StudyBible account — PureStream" active="delete-account">
  <main>
    <PageIntro eyebrow="Account & privacy" title="Delete your account" intro="You can permanently remove your StudyBible account and synced study data here, even if you no longer have the app." />

    <section class="section">
      <div class="container deletion-grid">
        <div class="prose">
          <h2>What is removed</h2>
          <ul>
            <li>Your StudyBible account, email address, and linked sign-in identities.</li>
            <li>Bookmarks, highlights, and bookmark notes synced to the server.</li>
          </ul>
          <p>Data saved only on a device cannot be reached from this website. Use <strong>Settings → Advanced → Clear Local Data</strong> on each device to remove local copies. App versions with an in-app Delete Account action also clear local data on that device.</p>
          <p>If database backups are enabled, residual copies may remain for up to 30 days under Supabase's standard backup retention periods. Read our <a href="/privacy/">privacy policy</a> for more detail.</p>
        </div>

        <div class="form-card">
          <p class="eyebrow">Verify ownership</p>
          <h2 class="serif" style="font-size:34px;font-weight:400;line-height:1.1;margin:0 0 12px">Sign in to continue</h2>
          <p class="body-muted small" style="margin:0 0 28px">Use the email and password, Google account, or email sign-in link associated with your StudyBible account. The email link will not create a new account.</p>

          <div id="signed-out">
            <form id="password-form">
              <div class="field"><label for="email">Email address</label><input class="input" id="email" name="email" type="email" autocomplete="email" required /></div>
              <div class="field"><label for="password">Password</label><input class="input" id="password" name="password" type="password" autocomplete="current-password" /></div>
              <div class="button-row" style="margin:22px 0 14px"><button class="button button-primary" type="submit">Sign in with password</button></div>
              <div class="button-row"><button class="button" id="email-link" type="button">Email me a sign-in link</button><button class="button" id="google-sign-in" type="button">Sign in with Google</button></div>
            </form>
          </div>

          <div id="signed-in" class="hidden">
            <p class="body-muted small">Signed in as <strong id="signed-in-email"></strong></p>
            <div class="danger-panel" style="margin:24px 0"><p>This permanently deletes your account and synced study data. The action cannot be undone.</p></div>
            <label class="checkline"><input id="confirm-deletion" type="checkbox" /><span>I understand that deleting my StudyBible account and synced data cannot be undone.</span></label>
            <div class="button-row"><button class="button button-danger" id="delete-account" type="button" disabled>Permanently delete account</button><button class="button" id="sign-out" type="button">Use another account</button></div>
          </div>
          <p id="status" class="status" role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const status = document.querySelector<HTMLParagraphElement>('#status')!;
  const signedOut = document.querySelector<HTMLElement>('#signed-out')!;
  const signedIn = document.querySelector<HTMLElement>('#signed-in')!;
  const emailInput = document.querySelector<HTMLInputElement>('#email')!;
  const passwordInput = document.querySelector<HTMLInputElement>('#password')!;
  const confirmation = document.querySelector<HTMLInputElement>('#confirm-deletion')!;
  const deleteButton = document.querySelector<HTMLButtonElement>('#delete-account')!;

  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  if (!url || !key) {
    signedOut.classList.add('hidden');
    status.textContent = 'Account deletion is temporarily unavailable. Please try again later.';
  } else {
    const client = createClient(url, key, {
      auth: { flowType: 'pkce', detectSessionInUrl: true },
    });

    function showUser(user: { email?: string } | null) {
      signedIn.classList.toggle('hidden', !user);
      signedOut.classList.toggle('hidden', Boolean(user));
      document.querySelector<HTMLElement>('#signed-in-email')!.textContent = user?.email ?? '';
      confirmation.checked = false;
      deleteButton.disabled = true;
    }

    client.auth.onAuthStateChange((_event, session) => { showUser(session?.user ?? null); });
    void client.auth.getUser().then(({ data: { user } }) => showUser(user));

    document.querySelector<HTMLFormElement>('#password-form')!.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = 'Signing in…';
      const { error } = await client.auth.signInWithPassword({
        email: emailInput.value.trim(), password: passwordInput.value,
      });
      passwordInput.value = '';
      status.textContent = error ? error.message : 'Signed in. Review the account shown below.';
      if (!error) {
        const { data: { user } } = await client.auth.getUser();
        showUser(user);
      }
    });

    document.querySelector<HTMLButtonElement>('#email-link')!.addEventListener('click', async () => {
      if (!emailInput.reportValidity()) return;
      status.textContent = 'Requesting a sign-in link…';
      const { error } = await client.auth.signInWithOtp({
        email: emailInput.value.trim(),
        options: { shouldCreateUser: false, emailRedirectTo: window.location.href.split(/[?#]/)[0] },
      });
      status.textContent = error ? error.message : 'If this is an existing StudyBible account, check that inbox for a sign-in link.';
    });

    document.querySelector<HTMLButtonElement>('#google-sign-in')!.addEventListener('click', async () => {
      status.textContent = 'Opening Google sign-in…';
      const { error } = await client.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: window.location.href.split(/[?#]/)[0] },
      });
      if (error) status.textContent = error.message;
    });

    confirmation.addEventListener('change', () => { deleteButton.disabled = !confirmation.checked; });
    document.querySelector<HTMLButtonElement>('#sign-out')!.addEventListener('click', async () => {
      await client.auth.signOut();
      status.textContent = 'Signed out.';
      showUser(null);
    });

    deleteButton.addEventListener('click', async () => {
      if (!confirmation.checked) return;
      deleteButton.disabled = true;
      status.textContent = 'Deleting your account and synced data…';
      const { error } = await client.functions.invoke('delete-account', { method: 'POST' });
      if (error) {
        status.textContent = 'Deletion failed. Please sign in again and retry.';
        deleteButton.disabled = false;
        return;
      }
      await client.auth.signOut({ scope: 'local' });
      showUser(null);
      status.textContent = 'Your StudyBible account and synced data have been deleted.';
    });
  }
</script>
