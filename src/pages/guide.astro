---
import ButtonLink from '../components/ButtonLink.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PageIntro from '../components/PageIntro.astro';
import PlatformList from '../components/PlatformList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { APP_CONFIG, FEATURES } from '../config/constants';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Features — StudyBible" active="guide">
  <main>
    <PageIntro eyebrow="Inside StudyBible" title="The tools around the text." intro="Read in a focused space, compare translations, and keep the ideas you want to revisit." />

    <section class="section">
      <div class="container">
        <SectionHeading eyebrow="Core features" title="A considered set of essentials" />
        <div class="feature-grid">{FEATURES.map(feature => <FeatureCard {...feature} />)}</div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container grid-two split-spacious">
        <div>
          <p class="eyebrow">How it works</p>
          <h2 class="section-title">From reading to reflection.</h2>
          <p class="lead">The app follows a familiar rhythm: find the passage, read it closely, and keep what you learn.</p>
        </div>
        <ol class="list-clean">
          <li><strong>Choose a text.</strong><br /><span class="body-muted small">Browse available translations and download the ones you use.</span></li>
          <li><strong>Read side by side.</strong><br /><span class="body-muted small">Compare translations without leaving your place.</span></li>
          <li><strong>Mark the moment.</strong><br /><span class="body-muted small">Save a bookmark, highlight a line, or write a note.</span></li>
          <li><strong>Return anywhere.</strong><br /><span class="body-muted small">Use optional online sync to bring your study data to another device.</span></li>
        </ol>
      </div>
    </section>

    <section class="section">
      <div class="container grid-two split-spacious">
        <div>
          <p class="eyebrow">Availability</p>
          <h2 class="section-title">Study on your platform.</h2>
          <p class="lead">Evaluation builds are available now for Windows, Linux, and Android. Other platforms are in development.</p>
          <ButtonLink href={APP_CONFIG.RELEASES_URL} variant="primary" external>Get the latest build <span aria-hidden="true">↗</span></ButtonLink>
        </div>
        <PlatformList />
      </div>
    </section>
  </main>
</Layout>
