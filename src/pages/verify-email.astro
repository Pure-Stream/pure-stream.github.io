---
import Layout from '../layouts/Layout.astro';
import { ROUTES } from '../config/constants';

export const prerender = false;

const token = Astro.url.searchParams.get('token');
let verificationResult: { success: boolean; message: string } | null = null;
let error: string | null = null;

if (token) {
  try {
    const response = await fetch(`${Astro.url.origin}/api/auth/verify-email`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token }),
    });

    const data = await response.json();

    if (response.ok) {
      verificationResult = { success: true, message: data.message };
    } else {
      error = data.error || 'Email verification failed';
    }
  } catch (err) {
    error = 'An error occurred during verification. Please try again.';
    console.error('Verification error:', err);
  }
} else {
  error = 'No verification token provided';
}
---

<Layout title="Email Verification - PureStream's StudyBible" description="Verify your email address">
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="max-w-md w-full">
      <div class="bg-white/60 backdrop-blur-sm rounded-2xl shadow-xl p-8 border border-white/20 text-center">
        {
          verificationResult?.success ? (
            <>
              <div class="mb-6">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
                  <svg
                    class="w-8 h-8 text-green-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </div>
              </div>
              <h1 class="text-3xl font-display font-bold bg-gradient-to-r from-green-600 via-green-500 to-emerald-600 bg-clip-text text-transparent mb-2">
                Email Verified!
              </h1>
              <p class="text-gray-600 mb-8">
                Your email has been verified successfully. You can now sign in to your account.
              </p>
              <a
                href={ROUTES.LOGIN}
                class="inline-block w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold py-3 rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all shadow-md hover:shadow-lg"
              >
                Sign In
              </a>
            </>
          ) : (
            <>
              <div class="mb-6">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-red-100 rounded-full mb-4">
                  <svg
                    class="w-8 h-8 text-red-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M6 18L18 6M6 6l12 12"
                    />
                  </svg>
                </div>
              </div>
              <h1 class="text-3xl font-display font-bold bg-gradient-to-r from-red-600 via-red-500 to-rose-600 bg-clip-text text-transparent mb-2">
                Verification Failed
              </h1>
              <p class="text-gray-600 mb-2">{error}</p>
              <p class="text-gray-500 text-sm mb-8">
                Please check your email for a new verification link or contact support.
              </p>
              <a
                href={ROUTES.LOGIN}
                class="inline-block w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold py-3 rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all shadow-md hover:shadow-lg"
              >
                Back to Sign In
              </a>
            </>
          )
        }

        <a
          href={ROUTES.HOME}
          class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 transition-colors mt-6"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            />
          </svg>
          Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  div > div {
    animation: fadeInUp 0.5s ease-out;
  }
</style>
