---
import ButtonLink from '../components/ButtonLink.astro';
import InfoCard from '../components/InfoCard.astro';
import PageIntro from '../components/PageIntro.astro';
import { APP_CONFIG } from '../config/constants';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Feedback — StudyBible" active="feedback">
  <main>
    <PageIntro eyebrow="Feedback" title="Tell us what matters." intro="Report a problem, suggest an improvement, or follow the work already under way. StudyBible's feedback is organized in GitHub issues." />

    <section class="section">
      <div class="container grid-three">
        <InfoCard eyebrow="01 / Problems" title="Report a bug" description="Tell us what happened, what you expected, and which platform you are using." href={`${APP_CONFIG.GITHUB_URL}/issues/new?labels=bug`} linkLabel="Open a bug report" />
        <InfoCard eyebrow="02 / Ideas" title="Suggest a feature" description="Describe the task you are trying to do and how the app could make it easier." href={`${APP_CONFIG.GITHUB_URL}/issues/new?labels=enhancement`} linkLabel="Share an idea" />
        <InfoCard eyebrow="03 / Progress" title="See open work" description="Browse existing issues before opening a new one and follow the conversation." href={`${APP_CONFIG.GITHUB_URL}/issues`} linkLabel="Browse issues" />
      </div>
      <div class="container section-followup">
        <div class="notice"><strong>Before posting</strong><p>GitHub issues are public and require a GitHub account. Do not include passwords, access tokens, private notes, or other sensitive information. To remove your StudyBible account, use the <a class="text-link" href="/delete-account/">self-service deletion page</a>.</p></div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container grid-two split-centered">
        <div><p class="eyebrow">Follow the project</p><h2 class="section-title">Stay close to the work.</h2></div>
        <div><p class="lead" style="margin-top:0">Browse public releases and issues to see what has shipped and what people are discussing.</p><ButtonLink href={APP_CONFIG.GITHUB_URL} variant="primary" external>View releases and issues <span aria-hidden="true">↗</span></ButtonLink></div>
      </div>
    </section>
  </main>
</Layout>
