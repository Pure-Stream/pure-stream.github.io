---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import { APP_CONFIG } from '../config/constants';

// Static page - no server-side rendering needed
export const prerender = true;
---

<Layout title="Feedback - PureStream's StudyBible">
  <Navigation />

  <main class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-900 py-16 px-6 relative overflow-hidden">
    <!-- Animated background blobs -->
    <div class="absolute top-0 left-0 w-96 h-96 bg-blue-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob dark:opacity-10"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-purple-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000 dark:opacity-10"></div>
    <div class="absolute -bottom-8 left-20 w-96 h-96 bg-pink-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000 dark:opacity-10"></div>

    <div class="max-w-4xl mx-auto relative z-10">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <div class="mb-6 text-7xl">📝</div>
        <h1 class="text-5xl md:text-6xl font-bold bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent mb-4">
          Share Your Feedback
        </h1>
        <p class="text-xl text-slate-600 dark:text-slate-400 mb-2 max-w-2xl mx-auto">
          Help us improve StudyBible by reporting bugs, suggesting features, and sharing your ideas.
        </p>
        <p class="text-lg text-slate-500 dark:text-slate-400 max-w-2xl mx-auto">
          All feedback is managed on GitHub where you can track discussions and see how your suggestions are implemented.
        </p>
      </div>

      <!-- Primary CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
        <a
          href={`${APP_CONFIG.GITHUB_URL}/issues`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg hover:shadow-2xl hover:scale-105 transition-all duration-200 flex items-center justify-center gap-2 group"
        >
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0113 2.586L15.414 5A2 2 0 0116 6.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z"></path>
          </svg>
          View Issues
        </a>
        <a
          href={`${APP_CONFIG.GITHUB_URL}/issues/new`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-white dark:bg-slate-800 text-slate-900 dark:text-white font-semibold rounded-lg border-2 border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2 group"
        >
          <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Report New Issue
        </a>
      </div>

      <!-- Info Cards Grid -->
      <div class="grid md:grid-cols-3 gap-6 mb-16">
        <!-- Bug Reports Card -->
        <div class="bg-white/60 dark:bg-slate-800/60 backdrop-blur-md border border-white/20 dark:border-slate-700/20 rounded-2xl p-8 hover:shadow-xl transition-all duration-200 hover:bg-white/80 dark:hover:bg-slate-800/80">
          <div class="text-5xl mb-4">🐛</div>
          <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">Report a Bug</h3>
          <p class="text-slate-600 dark:text-slate-300 mb-6 leading-relaxed">
            Found something that isn't working as expected? Let us know so we can fix it quickly.
          </p>
          <a
            href={`${APP_CONFIG.GITHUB_URL}/issues/new?labels=bug`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 font-semibold hover:gap-3 transition-all group"
          >
            Report Bug
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Feature Requests Card -->
        <div class="bg-white/60 dark:bg-slate-800/60 backdrop-blur-md border border-white/20 dark:border-slate-700/20 rounded-2xl p-8 hover:shadow-xl transition-all duration-200 hover:bg-white/80 dark:hover:bg-slate-800/80">
          <div class="text-5xl mb-4">💡</div>
          <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">Suggest a Feature</h3>
          <p class="text-slate-600 dark:text-slate-300 mb-6 leading-relaxed">
            Have an idea to make StudyBible better? Share your feature requests and see community support.
          </p>
          <a
            href={`${APP_CONFIG.GITHUB_URL}/issues/new?labels=enhancement`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 font-semibold hover:gap-3 transition-all group"
          >
            Suggest Feature
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Browse Issues Card -->
        <div class="bg-white/60 dark:bg-slate-800/60 backdrop-blur-md border border-white/20 dark:border-slate-700/20 rounded-2xl p-8 hover:shadow-xl transition-all duration-200 hover:bg-white/80 dark:hover:bg-slate-800/80">
          <div class="text-5xl mb-4">👀</div>
          <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">Browse Issues</h3>
          <p class="text-slate-600 dark:text-slate-300 mb-6 leading-relaxed">
            See what others are working on, upvote ideas you like, and join the discussion.
          </p>
          <a
            href={`${APP_CONFIG.GITHUB_URL}/issues`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 font-semibold hover:gap-3 transition-all group"
          >
            View All Issues
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- GitHub Account Info -->
      <div class="bg-blue-50 dark:bg-blue-950/30 border-2 border-blue-200 dark:border-blue-800 rounded-2xl p-8 text-center max-w-2xl mx-auto">
        <div class="mb-4 text-4xl">🔗</div>
        <h2 class="text-2xl font-bold text-blue-900 dark:text-blue-100 mb-3">Need a GitHub Account?</h2>
        <p class="text-blue-800 dark:text-blue-200 mb-6 leading-relaxed">
          GitHub is free and takes just a few minutes to set up. You'll be able to:
        </p>
        <ul class="text-left text-blue-800 dark:text-blue-200 mb-6 space-y-2 inline-block">
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"></path>
            </svg>
            Report and track bugs
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"></path>
            </svg>
            Upvote and comment on issues
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"></path>
            </svg>
            Be part of the community
          </li>
        </ul>
        <a
          href="https://github.com/signup"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-all hover:shadow-lg"
        >
          Create Free GitHub Account
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  @keyframes blob {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
  }

  .animate-blob {
    animation: blob 7s infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>
