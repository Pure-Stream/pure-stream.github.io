---
interface Props {
  currentPage?: 'home' | 'feedback' | 'dashboard';
  showThemeToggle?: boolean;
}

const { currentPage = 'home', showThemeToggle = true } = Astro.props;
const session = Astro.locals.session;
const user = session?.user;
---

<nav class="sticky top-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-700 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 py-3">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <span class="text-2xl">📖</span>
        <span class="font-display text-xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
          StudyBible
        </span>
      </a>

      <!-- Navigation Links & Actions -->
      <div class="flex items-center gap-6">
        {currentPage === 'dashboard' ? (
          <!-- Dashboard Navigation -->
          <>
            <a
              href="/dashboard"
              class="text-blue-600 dark:text-blue-400 font-semibold hidden md:block"
            >
              Dashboard
            </a>
            <a
              href="/#features"
              class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium transition-colors hidden md:block"
            >
              Features
            </a>
            <a
              href="/feedback"
              class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium transition-colors hidden md:block"
            >
              Feedback
            </a>
            <span class="text-slate-700 dark:text-slate-300 text-sm hidden sm:inline">
              Hi, {user?.name || user?.email}
            </span>
            <button
              id="logout-button"
              type="button"
              class="px-4 py-2 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition-colors"
            >
              Logout
            </button>
          </>
        ) : (
          <!-- Home/Feedback Navigation -->
          <>
            <a
              href={currentPage === 'home' ? '#features' : '/#features'}
              class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium transition-colors hidden sm:block"
            >
              Features
            </a>
            <a
              href={currentPage === 'home' ? '#download' : '/#download'}
              class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium transition-colors hidden sm:block"
            >
              Download
            </a>
            <a
              href="/feedback"
              class={currentPage === 'feedback'
                ? 'text-blue-600 dark:text-blue-400 font-medium'
                : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium transition-colors'
              }
            >
              Feedback
            </a>

            {showThemeToggle && (
              <button
                id="themeToggle"
                class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all"
                aria-label="Toggle theme"
              >
                <svg id="sunIcon" class="w-5 h-5 text-slate-600 dark:text-slate-400 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                <svg id="moonIcon" class="w-5 h-5 text-slate-600 dark:text-slate-400 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                </svg>
              </button>
            )}

            {session ? (
              <a
                href="/dashboard"
                class="px-4 py-2 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg hover:shadow-lg transition-all text-sm"
              >
                Dashboard
              </a>
            ) : (
              <a
                href="/login"
                class="px-4 py-2 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg hover:shadow-lg transition-all text-sm"
              >
                Login
              </a>
            )}
          </>
        )}
      </div>
    </div>
  </div>
</nav>

<script>
  import { authClient } from '../lib/auth-client';

  // Handle logout
  const logoutButton = document.getElementById('logout-button');
  if (logoutButton) {
    logoutButton.addEventListener('click', async () => {
      try {
        await authClient.signOut({
          fetchOptions: {
            onSuccess: () => {
              window.location.href = '/';
            }
          }
        });
      } catch (error) {
        console.error('Logout error:', error);
        // Redirect anyway to clear client state
        window.location.href = '/';
      }
    });
  }
</script>

{showThemeToggle && (
  <script>
    import { setupThemeToggle } from '../scripts/theme';

    // Setup theme toggle on page load
    document.addEventListener('DOMContentLoaded', () => {
      setupThemeToggle();
    });
  </script>
)}
