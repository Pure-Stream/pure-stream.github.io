---
interface Props {
  currentPage?: 'home' | 'feedback' | 'dashboard';
  showThemeToggle?: boolean;
}

const { currentPage = 'home', showThemeToggle = true } = Astro.props;
const session = Astro.locals.session;
const user = session?.user;
---

<nav class="sticky top-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-700 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 py-3">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-2xl transition-transform group-hover:scale-110">📖</span>
        <span class="font-display text-xl font-bold">
          <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">PureStream's</span>
          <span class="bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent"> StudyBible</span>
        </span>
      </a>

      <!-- Desktop Navigation Links & Actions -->
      <div class="hidden md:flex items-center gap-6">
        {currentPage === 'dashboard' ? (
          <>
            <a
              href="/dashboard"
              class="text-blue-600 dark:text-blue-400 font-semibold"
            >
              Dashboard
            </a>
            <a
              href="/#features"
              class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium transition-colors"
            >
              Features
            </a>
            <a
              href="/feedback"
              class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium transition-colors"
            >
              Feedback
            </a>
            <span class="text-slate-700 dark:text-slate-300 text-sm">
              Hi, {user?.name || user?.email?.split('@')[0]}
            </span>
            <button
              id="logout-button"
              type="button"
              class="px-4 py-2 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition-colors text-sm"
            >
              Logout
            </button>
          </>
        ) : (
          <>
            <a
              href={currentPage === 'home' ? '#features' : '/#features'}
              class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium transition-colors"
            >
              Features
            </a>
            <a
              href={currentPage === 'home' ? '#download' : '/#download'}
              class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium transition-colors"
            >
              Download
            </a>
            <a
              href="/feedback"
              class={currentPage === 'feedback'
                ? 'text-blue-600 dark:text-blue-400 font-medium'
                : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium transition-colors'
              }
            >
              Feedback
            </a>

            {showThemeToggle && (
              <button
                id="themeToggle"
                class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all"
                aria-label="Toggle theme"
              >
                <svg id="sunIcon" class="w-5 h-5 text-slate-600 dark:text-slate-400 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                <svg id="moonIcon" class="w-5 h-5 text-slate-600 dark:text-slate-400 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                </svg>
              </button>
            )}

            {session ? (
              <a
                href="/dashboard"
                class="px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg hover:shadow-lg transition-all text-sm"
              >
                Dashboard
              </a>
            ) : (
              <a
                href="/login"
                class="px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg hover:shadow-lg transition-all text-sm"
              >
                Login
              </a>
            )}
          </>
        )}
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center gap-4 md:hidden">
        {showThemeToggle && (
          <button
            id="mobileThemeToggle"
            class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800"
            aria-label="Toggle theme"
          >
            <svg class="w-5 h-5 text-slate-600 dark:text-slate-400 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <svg class="w-5 h-5 text-slate-600 dark:text-slate-400 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
          </button>
        )}
        <button
          id="mobile-menu-toggle"
          type="button"
          class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800"
        >
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Content -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 overflow-hidden transition-all duration-300">
    <div class="px-4 pt-2 pb-6 space-y-2">
      {currentPage === 'dashboard' ? (
        <>
          <a href="/dashboard" class="block px-3 py-3 rounded-lg text-base font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20">Dashboard</a>
          <a href="/#features" class="block px-3 py-3 rounded-lg text-base font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">Features</a>
          <a href="/feedback" class="block px-3 py-3 rounded-lg text-base font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">Feedback</a>
          <div class="px-3 py-3 text-sm text-slate-500 border-t border-slate-100 dark:border-slate-800 mt-2">
            Hi, {user?.name || user?.email?.split('@')[0]}
          </div>
          <button id="mobile-logout-button" class="w-full text-left px-3 py-3 rounded-lg text-base font-semibold text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20">Logout</button>
        </>
      ) : (
        <>
          <a href="/#features" class="block px-3 py-3 rounded-lg text-base font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">Features</a>
          <a href="/#download" class="block px-3 py-3 rounded-lg text-base font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">Download</a>
          <a href="/feedback" class="block px-3 py-3 rounded-lg text-base font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">Feedback</a>
          <div class="pt-4 mt-2 border-t border-slate-100 dark:border-slate-800">
            {session ? (
              <a href="/dashboard" class="block w-full text-center px-4 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-xl">Dashboard</a>
            ) : (
              <a href="/login" class="block w-full text-center px-4 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-xl">Login</a>
            )}
          </div>
        </>
      )}
    </div>
  </div>
</nav>

<script>
  import { authClient } from '../lib/auth-client';
  import { setupThemeToggle } from '../scripts/theme';

  // Mobile Menu Logic
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        menuIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
        menuIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    });
  }

  // Handle logout
  const handleLogout = async () => {
    try {
      await authClient.signOut({
        fetchOptions: {
          onSuccess: () => {
            window.location.href = '/';
          }
        }
      });
    } catch (error) {
      console.error('Logout error:', error);
      window.location.href = '/';
    }
  };

  document.getElementById('logout-button')?.addEventListener('click', handleLogout);
  document.getElementById('mobile-logout-button')?.addEventListener('click', handleLogout);

  // Setup theme toggle
  document.addEventListener('DOMContentLoaded', () => {
    setupThemeToggle();
    // Also bind mobile theme toggle
    const mobileThemeBtn = document.getElementById('mobileThemeToggle');
    if (mobileThemeBtn) {
      mobileThemeBtn.addEventListener('click', () => {
        const themeToggle = document.getElementById('themeToggle');
        themeToggle?.click();
      });
    }
  });
</script>
