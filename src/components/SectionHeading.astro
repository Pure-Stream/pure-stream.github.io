---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="section-title">{title}</h2>
  </div>
  {description && <p class="lead">{description}</p>}
</div>
