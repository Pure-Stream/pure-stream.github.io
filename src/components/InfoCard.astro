---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, description, href, linkLabel } = Astro.props;
---

<article class="panel info-card">
  <p class="eyebrow">{eyebrow}</p>
  <h3>{title}</h3>
  <p class="body-muted small">{description}</p>
  {href && linkLabel && <a class="text-link" href={href} target="_blank" rel="noopener noreferrer">{linkLabel} ↗</a>}
</article>
